{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "digest": {"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "class": {"enum":["small","medium","large"]},
    "arm": {"enum":["L","C","F","F-S","F-P","F-G","F-H"]},
    "symbol": {
      "type":"object","additionalProperties":false,
      "required":["path","symbol","symbol_kind","start_byte","end_byte","start_line","end_line","doc_digest"],
      "properties": {
        "path":{"type":"string","minLength":1,"maxLength":4096,"pattern":"^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.rs$"},
        "symbol":{"type":"string","minLength":1,"maxLength":512},
        "symbol_kind":{"enum":["function","struct","enum","trait","type","const","static","mod"]},
        "start_byte":{"type":"integer","minimum":0,"maximum":16777216},
        "end_byte":{"type":"integer","minimum":1,"maximum":16777216},
        "start_line":{"type":"integer","minimum":1,"maximum":1000000},
        "end_line":{"type":"integer","minimum":1,"maximum":1000000},
        "doc_digest":{"$ref":"#/$defs/digest"}
      }
    },
    "package": {
      "type":"object","additionalProperties":false,
      "required":["name","version","normalized_repository_url","vcs_commit","path_in_vcs","license","cargo_lock_checksum","registry_source"],
      "properties": {
        "name":{"type":"string","minLength":1,"maxLength":128},
        "version":{"type":"string","minLength":1,"maxLength":128},
        "normalized_repository_url":{"type":"string","format":"uri","pattern":"^https?://","maxLength":2048},
        "vcs_commit":{"type":"string","pattern":"^[0-9a-f]{40}$"},
        "path_in_vcs":{"type":"string","maxLength":4096,"pattern":"^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).*$"},
        "license":{"type":"string","minLength":1,"maxLength":512},
        "cargo_lock_checksum":{"$ref":"#/$defs/digest"},
        "registry_source":{"const":"crates.io"}
      }
    },
    "task": {
      "type":"object","additionalProperties":false,"required":["task_id","query","query_digest"],
      "properties": {
        "task_id":{"type":"string","pattern":"^rust-(small|medium|large)-task-[0-9]{2}$"},
        "query":{"type":"string","minLength":40,"maxLength":400},
        "query_digest":{"$ref":"#/$defs/digest"}
      }
    },
    "oracle": {
      "type":"object","additionalProperties":false,
      "required":["selection_hash","target","decoys","reference_edit","expected_post_edit_tree_digest"],
      "properties": {
        "selection_hash":{"$ref":"#/$defs/digest"},
        "target":{"$ref":"#/$defs/symbol"},
        "decoys":{"type":"array","minItems":3,"maxItems":3,"uniqueItems":true,"items":{"$ref":"#/$defs/symbol"}},
        "reference_edit": {
          "type":"object","additionalProperties":false,"required":["operation","utf8_text"],
          "properties": {
            "operation":{"const":"insert_utf8_before_registered_target_after_context_authorization"},
            "utf8_text":{"const":"#[doc = \"M005-W07 downstream localization check.\"]\n"}
          }
        },
        "expected_post_edit_tree_digest":{"$ref":"#/$defs/digest"}
      }
    },
    "unit": {
      "type":"object","additionalProperties":false,
      "required":["schedule_index","unit_id","repository_class","package","rust_sloc","source_file_count","source_bytes","source_digest","rust_source_digest","checksum_manifest_digest","task","oracle","arm_order"],
      "properties": {
        "schedule_index":{"type":"integer","minimum":0,"maximum":71},
        "unit_id":{"type":"string","pattern":"^rust-(small|medium|large)-[0-9]{2}$"},
        "repository_class":{"$ref":"#/$defs/class"},
        "package":{"$ref":"#/$defs/package"},
        "rust_sloc":{"type":"integer","minimum":1,"maximum":10000000},
        "source_file_count":{"type":"integer","minimum":1,"maximum":100000},
        "source_bytes":{"type":"integer","minimum":1,"maximum":536870912},
        "source_digest":{"$ref":"#/$defs/digest"},
        "rust_source_digest":{"$ref":"#/$defs/digest"},
        "checksum_manifest_digest":{"$ref":"#/$defs/digest"},
        "task":{"$ref":"#/$defs/task"},
        "oracle":{"$ref":"#/$defs/oracle"},
        "arm_order":{"type":"array","minItems":7,"maxItems":7,"uniqueItems":true,"items":{"$ref":"#/$defs/arm"}}
      }
    }
  },
  "type":"object","additionalProperties":false,
  "required":["schema_version","kind","selection_algorithm","candidate_repository_count","classes","units"],
  "properties": {
    "schema_version":{"const":"2.0"},
    "kind":{"const":"m005_w07_registry_corpus"},
    "selection_algorithm":{"type":"string","minLength":200,"maxLength":2048},
    "candidate_repository_count":{"type":"integer","minimum":72,"maximum":10000},
    "classes": {
      "type":"array","minItems":3,"maxItems":3,"items":{
        "type":"object","additionalProperties":false,
        "required":["name","minimum_rust_sloc","maximum_rust_sloc","units","analysis_unit"],
        "properties": {
          "name":{"$ref":"#/$defs/class"},
          "minimum_rust_sloc":{"type":"integer","minimum":1,"maximum":10000000},
          "maximum_rust_sloc":{"type":"integer","minimum":1,"maximum":10000000},
          "units":{"const":24},
          "analysis_unit":{"const":"published_crate_source_snapshot"}
        }
      }
    },
    "units":{"type":"array","minItems":72,"maxItems":72,"items":{"$ref":"#/$defs/unit"}}
  }
}
