{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "canonical_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logical_path", "size", "file_sha256", "canonical_sha256"],
      "properties": {
        "logical_path": { "type": "string", "minLength": 1 },
        "size": { "type": "integer", "minimum": 1 },
        "file_sha256": { "$ref": "#/$defs/digest" },
        "canonical_sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logical_path", "stored_path", "uncompressed_size", "uncompressed_sha256", "compressed_size", "compressed_sha256"],
      "properties": {
        "logical_path": { "type": "string", "minLength": 1 },
        "stored_path": { "type": "string", "pattern": "^payload/" },
        "uncompressed_size": { "type": "integer", "minimum": 1, "maximum": 536870912 },
        "uncompressed_sha256": { "$ref": "#/$defs/digest" },
        "compressed_size": { "type": "integer", "minimum": 1, "maximum": 52428800 },
        "compressed_sha256": { "$ref": "#/$defs/digest" }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "experiment_id", "source_commit", "preregistration", "corpus_manifest", "public_key", "compression", "aggregate_uncompressed_size", "aggregate_compressed_size", "entries"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "kind": { "const": "m005_w07_evidence_archive" },
    "experiment_id": { "const": "m005-w07-rust-registry-v6" },
    "source_commit": { "const": "c6f00fe6dcd51ccfc6d571708d65da6d8fbb0dab" },
    "preregistration": { "$ref": "#/$defs/canonical_input" },
    "corpus_manifest": { "$ref": "#/$defs/canonical_input" },
    "public_key": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logical_path", "size", "file_sha256", "subject_public_key_info_sha256"],
      "properties": {
        "logical_path": { "const": "eval/corpora/retrieval/public-key.pem" },
        "size": { "type": "integer", "minimum": 1 },
        "file_sha256": { "$ref": "#/$defs/digest" },
        "subject_public_key_info_sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "compression": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "level", "frames_per_file", "checksum", "content_size", "dictionary", "decoder_crate", "decoder_version", "decoder_default_features", "maximum_window_size"],
      "properties": {
        "format": { "const": "zstd" },
        "level": { "const": 19 },
        "frames_per_file": { "const": 1 },
        "checksum": { "const": true },
        "content_size": { "const": true },
        "dictionary": { "const": false },
        "decoder_crate": { "const": "zstd" },
        "decoder_version": { "const": "0.13.3" },
        "decoder_default_features": { "const": false },
        "maximum_window_size": { "const": 8388608 }
      }
    },
    "aggregate_uncompressed_size": { "type": "integer", "minimum": 1, "maximum": 536870912 },
    "aggregate_compressed_size": { "type": "integer", "minimum": 1 },
    "entries": { "type": "array", "minItems": 9, "maxItems": 9, "items": { "$ref": "#/$defs/entry" } }
  }
}
