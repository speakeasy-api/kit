{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kit.dev/eval/manifests/schema/v1/task.schema.json",
  "title": "Kit evaluation task manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "task_id",
    "task_version",
    "repository",
    "specification_digest",
    "scaffold_digest"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "kind": { "const": "task" },
    "task_id": { "$ref": "#/$defs/id" },
    "task_version": { "$ref": "#/$defs/id" },
    "repository": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "url", "commit"],
          "properties": {
            "source": { "enum": ["https", "ssh"] },
            "url": { "type": "string", "format": "uri", "minLength": 1 },
            "commit": { "$ref": "#/$defs/commit" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "fixture", "commit", "fixture_grant"],
          "properties": {
            "source": { "const": "local_fixture" },
            "fixture": { "$ref": "#/$defs/id" },
            "commit": { "$ref": "#/$defs/commit" },
            "fixture_grant": { "$ref": "#/$defs/id" }
          }
        }
      ]
    },
    "specification_digest": { "$ref": "#/$defs/digest" },
    "scaffold_digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$" }
  }
}
