{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kit.dev/eval/manifests/schema/v1/environment.schema.json",
  "title": "Kit evaluation environment manifest v1.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "environment_id",
    "image_digest",
    "architecture",
    "model",
    "components"
  ],
  "properties": {
    "schema_version": { "const": "1.1" },
    "kind": { "const": "environment" },
    "environment_id": { "$ref": "#/$defs/id" },
    "image_digest": { "$ref": "#/$defs/digest" },
    "architecture": { "enum": ["x86_64", "aarch64"] },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "name", "snapshot", "reasoning_effort", "model_digest", "settings_digest", "provider_capability_digest"],
      "properties": {
        "provider": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "snapshot": { "type": "string", "minLength": 1 },
        "reasoning_effort": { "enum": ["none", "low", "medium", "high"] },
        "model_digest": { "$ref": "#/$defs/digest" },
        "settings_digest": { "$ref": "#/$defs/digest" },
        "provider_capability_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prompt_digest",
        "tools_digest",
        "router_digest",
        "retry_policy_digest",
        "verifier_digest"
      ],
      "properties": {
        "prompt_digest": { "$ref": "#/$defs/digest" },
        "tools_digest": { "$ref": "#/$defs/digest" },
        "router_digest": { "$ref": "#/$defs/digest" },
        "retry_policy_digest": { "$ref": "#/$defs/digest" },
        "verifier_digest": { "$ref": "#/$defs/digest" }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
