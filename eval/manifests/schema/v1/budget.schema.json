{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kit.dev/eval/manifests/schema/v1/budget.schema.json",
  "title": "Kit evaluation budget manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "budget_id", "limits"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "kind": { "const": "budget" },
    "budget_id": { "$ref": "#/$defs/id" },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpu_seconds",
        "memory_bytes",
        "disk_bytes",
        "network_bytes",
        "processes",
        "wall_seconds",
        "turns",
        "tokens",
        "dollars_usd"
      ],
      "properties": {
        "cpu_seconds": { "type": "integer", "minimum": 0 },
        "memory_bytes": { "type": "integer", "minimum": 0 },
        "disk_bytes": { "type": "integer", "minimum": 0 },
        "network_bytes": { "type": "integer", "minimum": 0 },
        "processes": { "type": "integer", "minimum": 0 },
        "wall_seconds": { "type": "integer", "minimum": 0 },
        "turns": { "type": "integer", "minimum": 0 },
        "tokens": { "type": "integer", "minimum": 0 },
        "dollars_usd": { "type": "number", "minimum": 0 }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" }
  }
}
