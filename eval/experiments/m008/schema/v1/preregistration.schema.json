{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kit.dev/eval/experiments/m008/schema/v1/preregistration.schema.json",
  "title": "Kit M008-W11 preregistration ordering anchor v1",
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:(?!0{64}$)[0-9a-f]{64}$" },
    "sha1": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "bounded_string": { "type": "string", "minLength": 1, "maxLength": 16384 },
    "metric": { "enum": ["success_rate", "intervention_rate", "mean_cost_usd", "mean_latency_ms", "verification_rate"] },
    "direction": { "enum": ["higher_is_better", "lower_is_better"] },
    "estimand_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "direction", "estimand", "role"],
      "properties": {
        "metric": { "$ref": "#/$defs/metric" },
        "direction": { "$ref": "#/$defs/direction" },
        "estimand": { "$ref": "#/$defs/bounded_string" },
        "role": { "enum": ["confirmatory", "exploratory"] }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "kind", "experiment_id", "state", "document_role", "evidence_status",
    "ordering_anchor", "immutable_inputs", "output_digest_rule", "baseline_policy",
    "candidate_policy", "estimands", "gates", "slo", "sampling", "cell_matrix", "policies",
    "load_fairness_suite", "registration_protocol", "promotion_rollback", "non_claims",
    "external_blockers"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "kind": { "const": "m008_w11_preregistration" },
    "experiment_id": { "const": "m008-w11-routed-policy-v1" },
    "state": { "const": "PRE_IMPLEMENTATION_FROZEN" },
    "document_role": { "$ref": "#/$defs/bounded_string" },
    "evidence_status": { "const": "NO_MEASURED_EVIDENCE" },
    "ordering_anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["anchor_commit", "anchor_tree", "frozen_at_utc", "frozen_at_derivation", "m008_implementation_paths", "paths_absent_at_anchor", "ordering_rule", "verification_command"],
      "properties": {
        "anchor_commit": { "const": "00f5185202dc794682231f79468aa7dcfad05d83" },
        "anchor_tree": { "const": "2607a996cf5183624306c946f2e893abebb9fe9d" },
        "frozen_at_utc": { "const": "2026-08-02T15:09:11Z" },
        "frozen_at_derivation": { "$ref": "#/$defs/bounded_string" },
        "m008_implementation_paths": {
          "const": [
            "docs/compatibility/ext-m008.yaml",
            "src/api/http/batch.rs",
            "src/runtime/affinity/",
            "src/runtime/cache/",
            "src/runtime/extensions/",
            "src/runtime/parallel/batch.rs",
            "src/runtime/router/",
            "src/runtime/scheduler/fairness.rs",
            "src/runtime/speculation/",
            "tests/adversarial/memo_authz.rs",
            "tests/adversarial/policy_floor.rs",
            "tests/conformance/affinity_health.rs",
            "tests/conformance/batch_join.rs",
            "tests/conformance/build_cache.rs",
            "tests/conformance/ext_m008.rs",
            "tests/conformance/failure_signature.rs",
            "tests/conformance/policy_rollout.rs",
            "tests/conformance/router_features.rs",
            "tests/conformance/sched_fairness.rs",
            "tests/conformance/speculation_quota.rs",
            "tests/conformance/voi_ranking.rs"
          ]
        },
        "paths_absent_at_anchor": { "const": true },
        "ordering_rule": { "$ref": "#/$defs/bounded_string" },
        "verification_command": { "$ref": "#/$defs/bounded_string" }
      }
    },
    "immutable_inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rfc_digest", "implementation_plan_digest", "core_components_schema_digest", "core_preregistration_schema_digest", "core_registration_schema_digest", "core_paired_template_digest", "digest_rule"],
      "properties": {
        "rfc_digest": { "const": "sha256:ed988c75a8c3798c6f8967f51ced0f374ab15b81b800349d54a4894766daa6d4" },
        "implementation_plan_digest": { "const": "sha256:86305bf632fe0cd9591d6c872c097e96c8360e6d2cac4fadf04e36fdfe1708bd" },
        "core_components_schema_digest": { "const": "sha256:d7668dad02ddf380d658e0cd462287330f4d4a8daf30e6c90c8a18c65fec80ec" },
        "core_preregistration_schema_digest": { "const": "sha256:222768a9ae69b2acd31ce3ae718f843686a7ae2c042b09964db89f9fe4ed23b0" },
        "core_registration_schema_digest": { "const": "sha256:8e681d2052e2195fd223cf02dad702fe55a282d953ac66c8e86f61d4c9bd9d46" },
        "core_paired_template_digest": { "const": "sha256:830208cd0f2fc6e2dfbe172dcf48c30b9c5f7b2ed517bcf2a521132a91406953" },
        "digest_rule": { "$ref": "#/$defs/bounded_string" }
      }
    },
    "output_digest_rule": { "$ref": "#/$defs/bounded_string" },
    "baseline_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "definition", "frozen"],
      "properties": {
        "name": { "const": "fixed-serial-baseline-v1" },
        "definition": { "$ref": "#/$defs/bounded_string" },
        "frozen": { "const": true }
      }
    },
    "candidate_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "definition", "config_binding", "frozen"],
      "properties": {
        "name": { "const": "routed-policy-v1" },
        "definition": { "$ref": "#/$defs/bounded_string" },
        "config_binding": { "$ref": "#/$defs/bounded_string" },
        "frozen": { "const": true }
      }
    },
    "estimands": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "secondary"],
      "properties": {
        "primary": {
          "allOf": [
            { "$ref": "#/$defs/estimand_entry" },
            { "properties": { "metric": { "const": "success_rate" }, "direction": { "const": "higher_is_better" }, "role": { "const": "confirmatory" } } }
          ]
        },
        "secondary": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "allOf": [
              { "$ref": "#/$defs/estimand_entry" },
              { "properties": { "role": { "const": "exploratory" } } }
            ]
          }
        }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["correctness_noninferiority", "safety", "acceptance_rule_provenance"],
      "properties": {
        "correctness_noninferiority": {
          "type": "object",
          "additionalProperties": false,
          "required": ["metric", "margin", "scientific_max_margin", "rule"],
          "properties": {
            "metric": { "const": "success_rate" },
            "margin": { "const": 0.05 },
            "scientific_max_margin": { "const": 0.1 },
            "rule": { "$ref": "#/$defs/bounded_string" }
          }
        },
        "safety": {
          "type": "object",
          "additionalProperties": false,
          "required": ["authority", "isolation", "cache_authorization", "starvation"],
          "properties": {
            "authority": { "$ref": "#/$defs/bounded_string" },
            "isolation": { "$ref": "#/$defs/bounded_string" },
            "cache_authorization": { "$ref": "#/$defs/bounded_string" },
            "starvation": { "$ref": "#/$defs/bounded_string" }
          }
        },
        "acceptance_rule_provenance": { "$ref": "#/$defs/bounded_string" }
      }
    },
    "slo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interactive_latency_p95", "interactive_latency_p99", "load_conditions", "cost", "trial_budget_ms", "trial_budget_usd", "budget_rule"],
      "properties": {
        "interactive_latency_p95": { "$ref": "#/$defs/bounded_string" },
        "interactive_latency_p99": { "$ref": "#/$defs/bounded_string" },
        "load_conditions": { "$ref": "#/$defs/bounded_string" },
        "cost": { "$ref": "#/$defs/bounded_string" },
        "trial_budget_ms": { "const": 14400000 },
        "trial_budget_usd": { "const": 250.0 },
        "budget_rule": { "$ref": "#/$defs/bounded_string" }
      }
    },
    "sampling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["complete_pairs", "roster_trials", "power_rationale", "seed_rule", "one_attempt_per_roster_entry", "no_retry"],
      "properties": {
        "complete_pairs": { "const": 960 },
        "roster_trials": { "const": 1920 },
        "power_rationale": { "$ref": "#/$defs/bounded_string" },
        "seed_rule": { "$ref": "#/$defs/bounded_string" },
        "one_attempt_per_roster_entry": { "const": true },
        "no_retry": { "const": true }
      }
    },
    "cell_matrix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axes", "cells", "pairs_per_cell", "allocation_rule", "fake_provider_lane", "missing_cell_rule"],
      "properties": {
        "axes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["corpus", "provider", "prompt", "tool", "protocol"],
          "properties": {
            "corpus": { "const": ["kit-native-tasks", "external-oss-tasks"] },
            "provider": { "const": ["production-provider-snapshot-pinned"] },
            "prompt": { "const": ["core-prompt-pinned"] },
            "tool": { "const": ["core-tools-direct", "core-tools-plus-composed"] },
            "protocol": { "const": ["interactive-class", "background-batch-class"] }
          }
        },
        "cells": { "const": 8 },
        "pairs_per_cell": { "const": 120 },
        "allocation_rule": { "$ref": "#/$defs/bounded_string" },
        "fake_provider_lane": { "$ref": "#/$defs/bounded_string" },
        "missing_cell_rule": { "$ref": "#/$defs/bounded_string" }
      }
    },
    "policies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stopping", "stopping_rule", "multiplicity", "exclusions", "failure", "error_imputation", "error_imputation_rule"],
      "properties": {
        "stopping": { "const": "fixed_roster" },
        "stopping_rule": { "$ref": "#/$defs/bounded_string" },
        "multiplicity": { "$ref": "#/$defs/bounded_string" },
        "exclusions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["unlisted", "allowed_reasons"],
          "properties": {
            "unlisted": { "const": "reject" },
            "allowed_reasons": { "const": [] }
          }
        },
        "failure": { "const": "include_as_observed" },
        "error_imputation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_cost_usd", "max_latency_ms"],
          "properties": {
            "max_cost_usd": { "const": 250.0 },
            "max_latency_ms": { "const": 14400000 }
          }
        },
        "error_imputation_rule": { "$ref": "#/$defs/bounded_string" }
      }
    },
    "load_fairness_suite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["definition", "pass_criteria"],
      "properties": {
        "definition": { "$ref": "#/$defs/bounded_string" },
        "pass_criteria": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/bounded_string" }
        }
      }
    },
    "registration_protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule", "authority"],
      "properties": {
        "rule": { "$ref": "#/$defs/bounded_string" },
        "authority": { "$ref": "#/$defs/bounded_string" }
      }
    },
    "promotion_rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["promotion_rule", "rollout_rule", "rollback_rule", "failure_rule"],
      "properties": {
        "promotion_rule": { "$ref": "#/$defs/bounded_string" },
        "rollout_rule": { "$ref": "#/$defs/bounded_string" },
        "rollback_rule": { "$ref": "#/$defs/bounded_string" },
        "failure_rule": { "$ref": "#/$defs/bounded_string" }
      }
    },
    "non_claims": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/bounded_string" }
    },
    "external_blockers": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/bounded_string" }
    }
  }
}
