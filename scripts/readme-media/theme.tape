# Shared look for every recording: the kitagent.dev terminal palette.
Set Shell zsh
Set FontFamily "IBM Plex Mono"
Set FontSize 30
Set Width 2400
Set Height 1440
Set Padding 48
Set TypingSpeed 40ms
Set Theme { "name": "kitagent", "background": "#0a0a0a", "foreground": "#f2f2ee", "cursor": "#f2f2ee", "selection": "#2a2a2a", "black": "#0a0a0a", "red": "#ff7b72", "green": "#58d68d", "yellow": "#f2c98a", "blue": "#8f9bff", "magenta": "#d2a8ff", "cyan": "#9fd3ff", "white": "#f2f2ee", "brightBlack": "#8a8a84", "brightRed": "#ff9b8f", "brightGreen": "#7fe0a6", "brightYellow": "#f7d9a6", "brightBlue": "#b7c0ff", "brightMagenta": "#e2c5ff", "brightCyan": "#bfe3ff", "brightWhite": "#ffffff" }
